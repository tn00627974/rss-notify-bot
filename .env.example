# 平台服務設定
DISCORD_TOKEN=
LINE_CHANNEL_ACCESS_TOKEN=
FEISHU_WEBHOOK_URL=

# 資料來源預設值 : json | pgsql 則一
SUBSCRIPTIONS_SOURCE=pgsql # pgsql 需要額外設定 DATABASE_URL
# SUBSCRIPTIONS_SOURCE=json # 需要 SUBSCRIPTIONS_FILE

# 訂閱設定：指向外部 JSON 檔案（推薦，方便維護）
# 格式請參考 subscriptions.json
SUBSCRIPTIONS_FILE=subscriptions.json

# PostgreSQL 資料庫連線設定（ SUBSCRIPTIONS_SOURCE=pgsql ）
DATABASE_URL=

# Discord Slash Commands（/rss_add /rss_list /target_add /subscribe）同步用的測試 guild
# 設定後只同步到此 guild，立即生效；留空則全域同步，套用到所有 guild 約需 1 小時
DISCORD_GUILD_ID=

# 其他設定
PORT=10000